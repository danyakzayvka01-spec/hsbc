rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{uid} {
      // A user may read only their own admin marker; all writes are console/server only.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Only an enabled administrator may create profiles or update balances.
      allow create, update: if isAdmin();
      allow delete: if false;

      match /documents/{documentId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create, update: if isAdmin()
          && request.resource.data.contentType == "application/pdf"
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes > 0
          && request.resource.data.sizeBytes <= 524288
          && request.resource.data.dataBase64 is string
          && request.resource.data.dataBase64.size() <= 699052;
        allow delete: if isAdmin();
      }

      match /transactions/{transactionId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /audit/{uid}/entries/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
